<%- include("partials/head.ejs") %>

<header class="app-header">
    <div class="brand-bar">
        <div class="logo-container">
            <img class="logo-header" src="/img/logo.jpg" alt="Logo de TechStore">
        </div>
        <div class="brand-info">
            <h1 class="brand-title">TechStore Autoservicio</h1>
        </div>
    </div>
</header>

<main>
    <div class="login-wrapper">
        <h3 class="centrado"><%= about %></h3>

        <form class="form-login" action="/login" method="POST">
            <input type="hidden" name="next" value="<%= next %>">
            <label for="emailUser">Correo Electrónico</label>
            <input type="email" name="email" id="emailUser" placeholder="correo@ejemplo.com" required>

            <label for="passwordUser">Contraseña</label>
            <input type="password" name="password" id="passwordUser" placeholder="••••••••" required>

            <div class="login-actions">
                <input type="submit" value="Iniciar Sesión">
            </div>
        </form>

        <p class="centrado">¿No tienes cuenta? <a href="<%= registerUrl %>">Regístrate como usuario común</a></p>

        <% if (typeof message !== "undefined") { %>
            <p class="mensaje exito centrado"><%= message %></p>
        <% } %>

        <% if (typeof error !== "undefined") { %>
            <p class="mensaje error centrado"><%= error %></p>
        <% } %>
    </div>
</main>

<%- include("partials/footer.ejs") %>
