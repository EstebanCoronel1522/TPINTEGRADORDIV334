<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

<main>
    <section class="createUser-container">
        <h3><%= about %></h3>

        <form id="createUserForm" action="/api/users" method="POST">
            <label for="nameUser">Nombre Completo</label>
            <input type="text" name="name" id="nameUser" placeholder="Ej: Juan Perez" required>

            <label for="emailUser">Correo Electrónico</label>
            <input type="email" name="email" id="emailUser" placeholder="usuario@autoservicio.com" required>

            <label for="passwordUser">Contraseña</label>
            <input type="password" name="password" id="passwordUser" placeholder="••••••••" required>

            <input type="submit" value="Crear usuario">
        </form>

        <p>Los usuarios nuevos se crean como usuarios normales. Desde esta lista puedes promoverlos a administradores.</p>

        <% if (typeof message !== "undefined") { %>
            <p class="mensaje exito centrado"><%= message %></p>
        <% } %>

        <% if (typeof error !== "undefined") { %>
            <p class="mensaje error centrado"><%= error %></p>
        <% } %>
    </section>

    <section class="users-management">
        <h3 class="centrado">Usuarios registrados</h3>
        <p id="usersStatus" role="status">Cargando usuarios...</p>
        <div class="users-table-wrapper">
            <table class="users-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody id="usersList"></tbody>
            </table>
        </div>
        <div id="usersManagement" data-current-user-id="<%= user.id %>"></div>
    </section>
</main>

<script src="/js/user-management.js"></script>
<%- include("partials/footer.ejs") %>
