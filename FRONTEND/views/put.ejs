<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

<main>
    <section class="modificar-container">
        <h3 class="centrado"><%= about %></h3>

        <form id="getProductForm">
            <label for="productSearch">Producto a modificar</label>
            <div class="product-search">
                <input type="search" id="productSearch" placeholder="Escribe para buscar..." autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="productOptions" required>
                <div id="productOptions" class="product-search-options" role="listbox" hidden></div>
            </div>
            <small id="productSearchStatus" role="status"></small>

            <input type="submit" value="Buscar Producto">
        </form>

        <div id="contenedor-productos"></div>
        <div id="contenedor-form"></div>
    </section>
</main>

<script src="/js/product-search.js"></script>
<script src="/js/put.js"></script>

<%- include("partials/footer.ejs") %>
