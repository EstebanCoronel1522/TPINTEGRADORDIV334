<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

<main>
    <section class="crear-container">
        <h3 class="centrado"><%= about %></h3>

        <form id="createProductForm">
            <label for="name">Nombre del Producto</label>
            <input type="text" name="name" id="name" placeholder="Ej: Teclado Mecánico RGB" required>

            <label for="price">Precio ($)</label>
            <input type="number" name="price" id="price" step="0.01" min="1" placeholder="Ej: 45000" required>

            <label for="category">Categoría</label>
            <select name="category" id="category" required>
                <option value="" disabled selected>Seleccione categoría</option>
                <option value="perifericos">Periféricos</option>
                <option value="componentes">Componentes</option>
            </select>

            <label for="image">URL de imagen (opcional)</label>
            <input type="url" name="image" id="image" placeholder="https://...">

            <label for="imageFile">O seleccionar imagen desde la PC</label>
            <input type="file" name="imageFile" id="imageFile" accept="image/png,image/jpeg,image/gif,image/webp">
            <small>PNG, JPG, GIF o WebP; máximo 5 MB. Se guarda en el servidor local.</small>

            <input type="submit" value="Crear Producto">
        </form>

        <div id="contenedor-productos"></div>
    </section>
</main>

<script src="/js/post.js"></script>

<%- include("partials/footer.ejs") %>
